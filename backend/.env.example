PROJECT_NAME="Checkout Queue API"
API_VERSION="0.1.0"
API_PREFIX="/api/v1"

# PostgreSQL database URL. Set this in Render/production environment variables.
# Local example:
DATABASE_URL="postgresql+psycopg2://api-access:admin123@localhost:5432/checkout_queue"
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

# JSON list of allowed frontend origins.
CORS_ORIGINS='["http://localhost:5173"]'

# Replace in every deployed environment.
SECRET_KEY="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=600
REFRESH_TOKEN_EXPIRE_DAYS=30

ML_MODEL_DIR="ml_models"
ML_MIN_TRAINING_SAMPLES=50
# Excel ML training upload limits (10 MiB and 10,000 rows by default)
ML_TRAINING_UPLOAD_MAX_BYTES=10485760
ML_TRAINING_UPLOAD_MAX_ROWS=10000

ENABLE_CHECKOUT_QUEUE=true
ENABLE_TRIAL_QUEUE=true
ENABLE_DEMO_TOOLS=false
ENABLE_IN_APP_SCHEDULER=true

# Dashboard history source. Live/Foresights (days=1) always use real database data.
CHECKOUT_ANALYTICS_HISTORY_MODE="static"
TRIAL_ANALYTICS_HISTORY_MODE="static"

NIGHTLY_QUEUE_CLEANUP_HOUR=0
NIGHTLY_QUEUE_CLEANUP_MINUTE=5
SCHEDULER_TIMEZONE="Asia/Kolkata"

MOCK_SMS_SHOULD_FAIL=false
